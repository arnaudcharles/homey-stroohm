        "titleFormatted": {
          "en": "Refresh now",
          "fr": "Actualiser maintenant",
          "nl": "Nu vernieuwen",
          "de": "Jetzt aktualisieren",
          "it": "Aggiorna ora"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=driver"
          }
        ]
