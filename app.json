            "name": "amount",
            "type": "number",
            "title": {
              "en": "Amount",
              "fr": "Montant",
              "nl": "Bedrag",
              "de": "Betrag",
              "it": "Importo"
            },
            "placeholder": {
              "en": "50",
              "fr": "50",
              "nl": "50",
              "de": "50",
              "it": "50"
            },
            "min": 0,
            "step": 1
          }
        ]
      }
