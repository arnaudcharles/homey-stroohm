  "bugs": {
    "url": "https://github.com/arnaudcharles/homey-stroohm/issues"
  },
  "api": {
    "getState": {
      "method": "GET",
      "path": "/state"
    },
    "setExternal": {
      "method": "POST",
      "path": "/external"
    },
    "setTariff": {
      "method": "POST",
      "path": "/tariff"
    },
    "getCsv": {
      "method": "GET",
      "path": "/csv"
    }
  },
  "support": "mailto:help@charlesarnaud.be",
  "flow": {
    "triggers": [
      {
        "id": "home_session_ended",
        "title": {
          "en": "Home charging session ended",
          "fr": "Session de recharge maison terminée",
          "nl": "Thuislaadsessie beëindigd",
          "de": "Ladevorgang zu Hause beendet",
          "it": "Sessione di ricarica a casa terminata"
        },
        "tokens": [
          {
            "name": "kwh",
            "type": "number",
            "title": {
              "en": "kWh",
              "fr": "kWh",
              "nl": "kWh",
              "de": "kWh",
              "it": "kWh"
            },
            "example": 12.4
          },
          {
            "name": "refund",
            "type": "number",
            "title": {
              "en": "Refund",
              "fr": "Remboursement",
              "nl": "Terugbetaling",
              "de": "Rückerstattung",
              "it": "Rimborso"
            },
            "example": 4.69
          },
          {
            "name": "net",
            "type": "number",
            "title": {
              "en": "Net result",
              "fr": "Gain/perte",
              "nl": "Nettoresultaat",
              "de": "Nettoergebnis",
              "it": "Risultato netto"
            },
            "example": -2.1
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=driver"
          }
        ]
      },
      {
        "id": "month_closed",
        "title": {
          "en": "A month has been closed",
          "fr": "Un mois vient d'être clôturé",
          "nl": "Een maand is afgesloten",
          "de": "Ein Monat wurde abgeschlossen",
          "it": "Un mese è stato chiuso"
        },
        "tokens": [
          {
            "name": "month",
            "type": "string",
            "title": {
              "en": "Month",
              "fr": "Mois",
              "nl": "Maand",
              "de": "Monat",
              "it": "Mese"
            },
            "example": "2026-10"
          },
          {
            "name": "kwh",
            "type": "number",
            "title": {
              "en": "Home kWh",
              "fr": "kWh maison",
              "nl": "kWh thuis",
              "de": "kWh zu Hause",
              "it": "kWh a casa"
            },
            "example": 130
          },
          {
            "name": "due",
            "type": "number",
            "title": {
              "en": "Refund due",
              "fr": "Remboursement dû",
              "nl": "Verschuldigd",
              "de": "Fällige Rückerstattung",
              "it": "Rimborso dovuto"
            },
            "example": 49.1
          },
          {
            "name": "pending",
            "type": "number",
            "title": {
              "en": "Pending",
              "fr": "En attente",
              "nl": "In afwachting",
              "de": "Ausstehend",
              "it": "In attesa"
            },
            "example": 14.3
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=driver"
          }
        ]
      },
      {
        "id": "public_session_ended",
        "title": {
          "en": "Public charging session ended",
