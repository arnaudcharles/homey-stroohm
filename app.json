      {
        "id": "refresh_now",
        "title": {
          "en": "Refresh now",
          "fr": "Actualiser maintenant",
          "nl": "Nu vernieuwen",
          "de": "Jetzt aktualisieren",
          "it": "Aggiorna ora"
